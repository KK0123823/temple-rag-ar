{"s":{"id":"rule_caishen_worship","name":"拜財神規範","type":"rule_set"},"p":"entry_rule","o":{"type":"literal","value":"入廟右進左出；切忌踩門檻；先天公爐稟告→依廟內主神順序→最後拜財神"},"source":"財神爺禁忌.txt"}
{"s":{"id":"rule_caishen_worship","name":"拜財神規範","type":"rule_set"},"p":"prayer_rule","o":{"type":"literal","value":"自我介紹（姓名住址生日）後再祈求；忌說負面話如很窮沒錢；願望要具體明確"},"source":"財神爺禁忌.txt"}
{"s":{"id":"rule_caishen_worship","name":"拜財神規範","type":"rule_set"},"p":"offering_rule","o":{"type":"literal","value":"常見供品：甜食、吉祥水果（多以單數）；忌豬肉（尤其拜武財神）"},"source":"財神爺禁忌.txt"}
{"s":{"id":"rule_caishen_worship","name":"拜財神規範","type":"rule_set"},"p":"time_rule","o":{"type":"literal","value":"每日可拜；常見靈驗時機：農曆初一十五、年節開市日；正月初五視為財神降臨日"},"source":"財神爺禁忌.txt"}
{"s":{"id":"rule_caishen_worship","name":"拜財神規範","type":"rule_set"},"p":"loan_money_rule","o":{"type":"literal","value":"若有借發財金：有借有還、期限內奉還並謝香油錢"},"source":"財神爺禁忌.txt"}

{"s":{"id":"bldg_three_gates","name":"三座大門","type":"architecture"},"p":"function","o":{"type":"literal","value":"中門多供神明/重大祭典；信徒走兩側小門象徵尊敬與階序"},"source":"建築歷史.txt"}
{"s":{"id":"bldg_pailou","name":"牌樓","type":"architecture"},"p":"function","o":{"type":"literal","value":"入口前高大門樓；題匾額對聯並雕飾龍鳳瑞獸；象徵神聖領域開始"},"source":"建築歷史.txt"}
{"s":{"id":"bldg_zhaoqiang","name":"照牆","type":"architecture"},"p":"function","o":{"type":"literal","value":"正門內牆；遮蔽視線、避邪、裝飾（常見彩繪雕刻）"},"source":"建築歷史.txt"}
{"s":{"id":"bldg_baidian","name":"拜殿","type":"architecture"},"p":"function","o":{"type":"literal","value":"正殿前聚集燒香膜拜空間；挑高適合大型儀式"},"source":"建築歷史.txt"}
{"s":{"id":"bldg_zhengdian","name":"正殿","type":"architecture"},"p":"function","o":{"type":"literal","value":"廟宇核心；主神安座；規模最大、雕飾華麗；精神中心"},"source":"建築歷史.txt"}
{"s":{"id":"bldg_houdian","name":"後殿","type":"architecture"},"p":"function","o":{"type":"literal","value":"正殿後方；供奉次要神祇或祖先；較安靜，象徵敬重延續"},"source":"建築歷史.txt"}
{"s":{"id":"bldg_hulong","name":"護龍","type":"architecture"},"p":"function","o":{"type":"literal","value":"正殿兩側延伸如手臂環抱；增添完整性與莊嚴"},"source":"建築歷史.txt"}
{"s":{"id":"bldg_zhonggulou","name":"鐘鼓樓","type":"architecture"},"p":"function","o":{"type":"literal","value":"廟前左右；一邊鐘一邊鼓；報時或祭典儀式；象徵莊嚴威儀"},"source":"建築歷史.txt"}
{"s":{"id":"bldg_xitai","name":"戲台","type":"architecture"},"p":"function","o":{"type":"literal","value":"廟前/廟旁酬神戲表演空間；娛樂神明並凝聚社群"},"source":"建築歷史.txt"}

{"s":{"id":"roof_yingshan","name":"硬山式","type":"roof_form"},"p":"description","o":{"type":"literal","value":"兩側山牆、屋脊平直；結構簡單；常見中小型廟宇"},"source":"建築歷史.txt"}
{"s":{"id":"roof_sichuiding","name":"四垂頂式","type":"roof_form"},"p":"description","o":{"type":"literal","value":"四邊屋簷下垂；方正莊嚴；常見主殿"},"source":"建築歷史.txt"}
{"s":{"id":"roof_fake_sichuiding","name":"假四垂頂式","type":"roof_form"},"p":"description","o":{"type":"literal","value":"模仿四垂頂但更簡化；常用附屬建築"},"source":"建築歷史.txt"}
{"s":{"id":"roof_chongyan","name":"重簷式","type":"roof_form"},"p":"description","o":{"type":"literal","value":"屋頂雙層簷邊；層層疊高增氣勢；常見大型/重要廟宇"},"source":"建築歷史.txt"}
{"s":{"id":"roof_sanchuanji","name":"三川脊","type":"roof_form"},"p":"description","o":{"type":"literal","value":"前殿屋頂三段式；中段最高兩邊較低；曲線優美；台灣代表形式"},"source":"建築歷史.txt"}
{"s":{"id":"roof_longhu_yanwei","name":"龍虎脊與燕尾脊","type":"roof_form"},"p":"description","o":{"type":"literal","value":"屋脊兩端翹起形似燕尾或龍虎；象徵吉祥避邪"},"source":"建築歷史.txt"}
{"s":{"id":"roof_yanweiwuji","name":"燕尾屋脊","type":"roof_form"},"p":"description","o":{"type":"literal","value":"屋頂翹起如燕尾；兼具排水與美觀；象徵吉祥和平安"},"source":"建築歷史.txt"}

{"s":{"id":"decor_menshen","name":"門神","type":"decoration"},"p":"function","o":{"type":"literal","value":"繪於大門；常見秦叔寶、尉遲恭；守護廟門防邪祟"},"source":"建築歷史.txt"}
{"s":{"id":"decor_shishizi","name":"石獅子","type":"decoration"},"p":"function","o":{"type":"literal","value":"廟門前一對；公獅踩繡球母獅帶小獅；象徵力量延續守護平安"},"source":"建築歷史.txt"}
{"s":{"id":"decor_longzhu","name":"龍柱","type":"decoration"},"p":"function","o":{"type":"literal","value":"大殿前石柱雕盤龍；象徵尊貴力量；提醒神明庇佑"},"source":"建築歷史.txt"}
{"s":{"id":"decor_bianeduilian","name":"匾額與對聯","type":"decoration"},"p":"function","o":{"type":"literal","value":"掛於門與殿堂；多為祈福讚頌文字；展現文化內涵"},"source":"建築歷史.txt"}
{"s":{"id":"decor_colors","name":"色彩（紅、金）","type":"decoration"},"p":"meaning","o":{"type":"literal","value":"紅色喜慶驅邪；金色尊貴神聖；常見配色"},"source":"建築歷史.txt"}
{"s":{"id":"decor_cut_paste","name":"剪黏與交趾陶","type":"decoration"},"p":"function","o":{"type":"literal","value":"陶瓷/玻璃拼貼成立體裝飾；常表現故事與祝福寓意"},"source":"建築歷史.txt"}
{"s":{"id":"decor_bidu","name":"壁堵","type":"decoration"},"p":"function","o":{"type":"literal","value":"牆面敘事與裝飾（像用圖畫講故事）"},"source":"建築歷史.txt"}

